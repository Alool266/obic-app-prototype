# OBIC local / staging placeholders — copy to .env and fill locally.
# NEVER commit real secrets. Production uses a secrets manager.
# Made by Dr Ali

# API
PORT=3000

# PostgreSQL (local DB `obic` already created on this machine)
DATABASE_URL=postgresql://obic:CHANGE_ME@localhost:5432/obic

# Auth — JWT signing material stays on the server only (never in Flutter)
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m

# SuperAdmin TOTP secrets at rest (32+ chars; falls back to JWT_SECRET if unset)
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY

# Phase 4 Admin lockdown
# Require SuperAdmin Authenticator (default true when NODE_ENV=production)
ADMIN_REQUIRE_TOTP=false
# Comma-separated IPs / CIDRs for /v1/admin (empty = allow all — local only)
# ADMIN_IP_ALLOWLIST=127.0.0.1,10.0.0.0/8
# Honor X-Forwarded-For / CF (set true behind Cloudflare / reverse proxy)
TRUST_PROXY=false
# Staging/prod CORS — comma-separated origins (empty in dev = reflect request)
# CORS_ORIGINS=https://admin.obicgp.com,http://127.0.0.1:3010

# Local only — prefer `npm run migration:run`. Never enable in production.
TYPEORM_SYNCHRONIZE=false

# Google Sign-In (OAuth / ID token verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Redis (Phase C) — optional for local; recommended for staging.
# If unset, API starts anyway: health reports redis:"skipped", throttle stays in-memory.
# Local: docker compose -f infra/docker-compose.yml up -d redis
REDIS_URL=redis://localhost:6379
# Or instead of REDIS_URL:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Optional later
# STRIPE_SECRET_KEY=

# --- Phase 5 Agora voice/video (free tier ~10k min/month) ---
# 1) Create free project: https://console.agora.io/
# 2) Copy App ID + enable App Certificate → copy certificate
# 3) Put BOTH in ONE of (never commit real keys; never put certificate in Flutter):
#    a) services/api/.env
#    b) services/api/agora.env (gitignored)
#    c) ~/.config/obic/agora.env  (recommended for local/trial)
# 4) Same vars on Render for trial/prod API
# Example ~/.config/obic/agora.env:
#    AGORA_APP_ID=your_app_id
#    AGORA_APP_CERTIFICATE=your_certificate
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# AGORA_TOKEN_TTL_SECONDS=3600

# --- Phase 5 OBIC AI (free tier — no paid OpenAI required) ---
# 1) Get a free Groq key (~2 min, no credit card):
#    https://console.groq.com/keys  → Create API Key → copy
# 2) Put the key in ONE of (never commit real keys):
#    a) services/api/.env  (gitignored)
#    b) services/api/ai.env (gitignored)
#    c) ~/.config/obic/ai.env  (recommended for local/trial)
# Example ~/.config/obic/ai.env:
#    AI_ENABLED=true
#    AI_PROVIDER=groq
#    AI_API_KEY=gsk_your_key_here
# Alternates (also free tiers):
#    AI_PROVIDER=gemini   + key from https://aistudio.google.com/api-keys
#    AI_PROVIDER=openrouter + key from https://openrouter.ai/keys (pick a :free model)
# Legacy paid OpenAI still works: AI_PROVIDER=openai + OPENAI_API_KEY=sk-...
AI_ENABLED=false
AI_PROVIDER=groq
AI_API_KEY=
# AI_MODEL=qwen/qwen3.8-27b
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_AUTO_REPLY=true
# AI_RATE_LIMIT_PER_MIN=12
# AI_MAX_TOKENS=400
# AI_AUTO_REPLY_MAX_TOKENS=220
# AI_TRANSLATE_MAX_TOKENS=800
# Provider-specific aliases (optional if AI_API_KEY is set):
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# --- Docker staging (infra/docker-compose.staging.yml) ---
# STAGING_DATABASE_URL=postgresql://obic:obic_staging_local@localhost:5433/obic
# Run migrations against staging: DATABASE_URL=$STAGING_DATABASE_URL npm run migration:run
# Staging compose sets REDIS_URL=redis://redis:6379 inside the API container.
# From the host (API via npm): REDIS_URL=redis://localhost:6379

# --- Email / phone verification ---
# Email: Resend free tier https://resend.com (100 emails/day on free)
# Leave unset → OTP logged to API console (trial/dev fallback)
RESEND_API_KEY=
RESEND_FROM=OBIC <onboarding@resend.dev>

# Phone SMS (production — ~¥0.05/SMS on Aliyun/Tencent for mainland CN):
# Prefer Aliyun or Tencent for +86. Twilio needs paid + geo permissions for CN.
# Trial: leave ALL SMS vars unset → phone verify OTP emailed (delivery: email_backup).
#   UI must say email, not SMS. Never claim "SMS sent" unless delivery=sms.
#
# Aliyun 短信服务 (dysmsapi) — https://dysmsapi.console.aliyun.com/
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Template variable name for the OTP (default: code)
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
#
# Tencent Cloud SMS — https://console.cloud.tencent.com/smsv2
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
#
# Twilio (optional; +86 usually needs paid account + geo permissions)
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# true = always include debugCode in API responses (local / trial only)
VERIFICATION_DEBUG=false
